set(args -std=c11 -Werror=format -Werror=unused-result -I${SOURCE_DIR}/include -fsyntax-only)
if(WORKERS)
  list(APPEND args -DCHECK_WORKERS=1)
endif()
if(SQLITE)
  list(APPEND args -DCHECK_SQLITE=1)
  foreach(directory IN LISTS SQLITE_INCLUDES)
    list(APPEND args -I${directory})
  endforeach()
endif()
execute_process(COMMAND "${CC}" ${args} -DCHECK_CASE=0 "${SOURCE_DIR}/tests/compile_checks.c"
                RESULT_VARIABLE result ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Valid API usage failed to compile: ${diagnostics}")
endif()
set(cases 1 2 5)
if(WORKERS)
  list(APPEND cases 3)
endif()
if(SQLITE)
  list(APPEND cases 4)
endif()
foreach(case IN LISTS cases)
  execute_process(COMMAND "${CC}" ${args} -DCHECK_CASE=${case} "${SOURCE_DIR}/tests/compile_checks.c"
                  RESULT_VARIABLE result ERROR_VARIABLE diagnostics)
  if(result EQUAL 0)
    message(FATAL_ERROR "Misuse case ${case} unexpectedly compiled")
  endif()
endforeach()
message(STATUS "Valid code compiles; format, return-value and advanced-header misuse are rejected")
