set(work "${BINARY_DIR}/cli tests")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
set(app "${work}/api with spaces")
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${app}" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${error}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(reject)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${app}" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(rc EQUAL 0)
    message(FATAL_ERROR "Invalid command unexpectedly succeeded: ${ARGV}\n${output}")
  endif()
endfunction()
execute_process(COMMAND "${CLI}" new "${app}" --sqlite RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "SQLite project creation failed")
endif()
run("${CLI}" --help)
run("${CLI}" generate resource posts title:string body:text views:integer published:boolean --dry-run)
if(EXISTS "${app}/resources/posts.c" OR EXISTS "${app}/.capi/lock")
  message(FATAL_ERROR "Dry-run wrote files")
endif()
file(READ "${app}/.capi/resources" manifest)
if(NOT manifest STREQUAL "")
  message(FATAL_ERROR "Dry-run changed manifest")
endif()
reject("${CLI}" generate resource ../escape title)
reject("${CLI}" generate resource posts id:integer)
reject("${CLI}" generate resource posts title:object)
reject("${CLI}" generate resource posts title:string title:text)
reject("${CLI}" generate resource sqlite_reserved title)
run("${CLI}" generate resource posts title:string body:text views:integer published:boolean)
file(SHA256 "${app}/resources/posts.c" before)
file(SHA256 "${app}/.capi/resources" manifest_before)
reject("${CLI}" generate resource posts title:text)
file(SHA256 "${app}/resources/posts.c" after)
file(SHA256 "${app}/.capi/resources" manifest_after)
if(NOT before STREQUAL after OR NOT manifest_before STREQUAL manifest_after)
  message(FATAL_ERROR "Collision changed controller/manifest")
endif()
# An output collision must not remove an existing file or publish a manifest.
file(WRITE "${app}/resources/occupied.c" "my controller\n")
reject("${CLI}" generate resource occupied title)
file(READ "${app}/resources/occupied.c" existing)
if(NOT existing STREQUAL "my controller\n" OR EXISTS "${app}/resources/occupied.h")
  message(FATAL_ERROR "Existing source was overwritten")
endif()
run("${CLI}" g resource flags active:boolean)
run("${CLI}" generate resource keywords select:text)
set(wide_fields)
foreach(i RANGE 1 16)
  list(APPEND wide_fields "field_${i}_abcdefghijklmnopqrstuv:string")
endforeach()
run("${CLI}" generate resource wide ${wide_fields})
run("${CLI}" routes)
if(NOT last_output MATCHES "PATCH   /posts/:id" OR NOT last_output MATCHES "DELETE  /flags/:id")
  message(FATAL_ERROR "Route listing missing generated routes: ${last_output}")
endif()
run("${CMAKE_COMMAND}" --install "${BINARY_DIR}" --prefix "${work}/prefix" --config "${CONFIG}")
set(flags "${COMPILE_FLAGS} -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror")
if(SANITIZE)
  string(APPEND flags " -fsanitize=address,undefined -fno-omit-frame-pointer")
elseif(THREAD_SANITIZE)
  string(APPEND flags " -fsanitize=thread -fno-omit-frame-pointer")
endif()
run("${CMAKE_COMMAND}" -S "${app}" -B "${app}/build" "-DCMAKE_PREFIX_PATH=${work}/prefix" "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_C_FLAGS=${flags}" "-DCMAKE_BUILD_TYPE=${CONFIG}")
run("${CMAKE_COMMAND}" --build "${app}/build" --config "${CONFIG}")
# The build must discover newly generated resources without a manual configure.
run("${CLI}" generate resource comments body)
run("${CMAKE_COMMAND}" --build "${app}/build" --config "${CONFIG}")
file(READ "${app}/build/resources.c" registry)
if(NOT registry MATCHES "resource_comments_register")
  message(FATAL_ERROR "Manifest change did not reconfigure the build")
endif()
file(MAKE_DIRECTORY "${work}/harness")
file(WRITE "${work}/harness/CMakeLists.txt" "cmake_minimum_required(VERSION 3.16)\nproject(generated_crud_test C)\nset(CMAKE_C_STANDARD 11)\nfind_package(capi CONFIG REQUIRED COMPONENTS sqlite)\nadd_executable(checks \"${SOURCE_DIR}/tests/cli.c\" \"${app}/resources/posts.c\" \"${app}/resources/flags.c\" \"${app}/resources/keywords.c\")\ntarget_include_directories(checks PRIVATE \"${app}\" \"${SOURCE_DIR}/tests\")\ntarget_link_libraries(checks PRIVATE capi::sqlite)\n")
run("${CMAKE_COMMAND}" -S "${work}/harness" -B "${work}/harness/build" "-DCMAKE_PREFIX_PATH=${work}/prefix" "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_C_FLAGS=${flags}" "-DCMAKE_BUILD_TYPE=${CONFIG}")
run("${CMAKE_COMMAND}" --build "${work}/harness/build" --config "${CONFIG}")
run("${work}/harness/build/checks" "${work}/test.db")
message(STATUS "${last_output}")
# Core-only scaffolding remains available with no SQLite package search.
run("${CLI}" new "${work}/plain")
run("${CMAKE_COMMAND}" -S "${work}/plain" -B "${work}/plain/build" "-DCMAKE_PREFIX_PATH=${work}/prefix" "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_C_FLAGS=${flags}" -DCMAKE_DISABLE_FIND_PACKAGE_SQLite3=ON "-DCMAKE_BUILD_TYPE=${CONFIG}")
run("${CMAKE_COMMAND}" --build "${work}/plain/build" --config "${CONFIG}")
