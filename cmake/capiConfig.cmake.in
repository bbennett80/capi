@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/capiTargets.cmake")
include(CMakeFindDependencyMacro)
foreach(component IN LISTS capi_FIND_COMPONENTS)
  if(component STREQUAL "sqlite" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/capiSqliteTargets.cmake")
    if(capi_FIND_REQUIRED_sqlite)
      find_dependency(SQLite3 3.8.7)
    else()
      find_package(SQLite3 3.8.7 QUIET)
    endif()
    set(capi_sqlite_FOUND ${SQLite3_FOUND})
    if(SQLite3_FOUND)
      if(NOT TARGET SQLite3::SQLite3)
        add_library(SQLite3::SQLite3 INTERFACE IMPORTED)
        target_link_libraries(SQLite3::SQLite3 INTERFACE SQLite::SQLite3)
      endif()
      if(NOT TARGET capi::sqlite)
        include("${CMAKE_CURRENT_LIST_DIR}/capiSqliteTargets.cmake")
      endif()
    endif()
  elseif(component STREQUAL "templates" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/capiTemplateTargets.cmake")
    if(NOT TARGET capi::templates)
      include("${CMAKE_CURRENT_LIST_DIR}/capiTemplateTargets.cmake")
    endif()
    set(capi_templates_FOUND TRUE)
  else()
    set(capi_${component}_FOUND FALSE)
    if(capi_FIND_REQUIRED_${component})
      set(capi_NOT_FOUND_MESSAGE "Unsupported or unavailable capi component: ${component}")
    endif()
  endif()
endforeach()
check_required_components(capi)
